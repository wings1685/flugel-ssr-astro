---
import Layout from "./Layout.astro";
import { buildFindQuery, fetchTasks } from "@/server/db/tasks/fetchTasks";
import { Find, List } from "@/components/features/index.ts";

const findQuery = buildFindQuery(Astro.url.search);
const tasks = await fetchTasks(findQuery);
---
<Layout>
	<Find { ...findQuery } />
	<List tasks={ tasks } />
</Layout>
