---
import { buildingData } from "../_models/performance";
import type { LiPatternsProps as Props } from "../_models/performance";

const { number }: Props = Astro.props;

const data = buildingData(number);
---
<ul>
	{data.map(item => (
		<li>{ item }</li>
	))}
</ul>
<script type="module">
	import { buildPerformance } from "../_models/performance";

	buildPerformance();
</script>
