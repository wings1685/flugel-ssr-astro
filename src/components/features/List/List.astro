---
import type { TaskSchema } from "@/_global/lib/validate";

type Props = {
	tasks: TaskSchema[];
};
const { tasks = [] }: Props = Astro.props;
---
<div>
	<h1>List</h1>
	<ul>
		{tasks.map(task => (
			<li>
				<p>title: { task.title }</p>
				<p>text: { task.text }</p>
			</li>
		))}
	</ul>
</div>
