---
import type { TaskItem } from "@/server/db/types.ts";

type Props = {
	data: TaskItem[];
};
const { data }: Props = Astro.props;
const tasks = data ?? [];
---
<div>
	<h1>List</h1>
	<ul>
		{tasks.map(task => (
			<li>
				<p>title: { task.title }</p>
				<p>text: { task.text }</p>
			</li>
		))}
	</ul>
</div>
