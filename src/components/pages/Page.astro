---
import Layout from "./Layout.astro";
import { apiFetch } from "@/_global/lib/api";
import { defaultFindValues } from "@/_global/lib/validate";
import { Find, List } from "@/components/features/index.ts";
import type { TaskItem } from "@/server/db/types.ts";
import type { FindSchema } from "@/_global/lib/validate.ts";
import "@/_global/styles/global.sass";

const params = Astro.url.searchParams;
const query = {
	title: params.get('title') ?? defaultFindValues.title,
	sort: params.get('sort') ?? defaultFindValues.sort,
} as FindSchema;
const data = await apiFetch<TaskItem[]>('/tasks', query);
---
<Layout>
	<main>
		<Find { ...query } />
		<List tasks={ data } />
	</main>
</Layout>
