---
import type { DeepGuard } from "@/_global/lib/types";
import type { TaskItem } from "@/server/db/types.ts";

type Props = {
	tasks: TaskItem[];
};
const { tasks = [] }: DeepGuard<Props> = Astro.props;
---
<div>
	<h1>List</h1>
	<ul>
		{tasks.map(task => (
			<li>
				<p>title: { task.title }</p>
				<p>text: { task.text }</p>
			</li>
		))}
	</ul>
</div>
